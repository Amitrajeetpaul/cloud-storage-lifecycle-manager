# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults below match docker-compose.yml.

# Express server port
PORT=4000

# Postgres connection string. Works with any standard Postgres provider —
# Vercel Postgres, Neon, Supabase, Railway, or a local instance for dev
# (e.g. postgres://localhost:5432/cslm_dev). docker-compose.yml's default:
DATABASE_URL=postgres://cslm:cslm@localhost:5432/cslm

# Set to "true" if your Postgres provider requires SSL (most hosted ones do;
# a local/self-hosted instance usually doesn't).
DATABASE_SSL=false

# How often the lifecycle engine re-evaluates all objects, in milliseconds.
# Only used by the local-dev background scheduler (server/scheduler.js,
# started by `npm run dev` / `node index.js`). In production on Vercel there
# is no persistent process to run a setInterval in — a Vercel Cron Job hits
# POST /api/cron/evaluate on a schedule instead (see vercel.json + CRON_SECRET
# below). Default here: 300000 (5 minutes).
EVALUATION_INTERVAL_MS=300000

# Set to "production" to switch morgan to combined (Apache-style) log format.
NODE_ENV=development

# Secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when it
# calls POST /api/cron/evaluate — required for that endpoint to work in
# production. Not used locally (the setInterval scheduler calls the engine
# directly, no HTTP round trip). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# MinIO / S3-compatible object storage connection settings
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=cslm

# Dashboard login (single admin user). CHANGE THESE before any real deployment —
# the defaults below are intentionally insecure and only meant for local dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign login tokens (JWTs). Set this explicitly in production —
# if left unset, a random one is generated at each server start, which
# invalidates all existing sessions on every restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
