# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults below match docker-compose.yml.

# Express server port
PORT=4000

# SQLite database file path
DB_PATH=./lifecycle.db

# How often the lifecycle engine re-evaluates all objects, in milliseconds.
# Default: 300000 (5 minutes). Lower this for demos/testing so transitions
# are visible quickly; a real deployment would typically use something like
# an hourly or daily interval.
EVALUATION_INTERVAL_MS=300000

# Set to "production" to switch morgan to combined (Apache-style) log format.
NODE_ENV=development

# MinIO connection settings
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=cslm

# Dashboard login (single admin user). CHANGE THESE before any real deployment —
# the defaults below are intentionally insecure and only meant for local dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign login tokens (JWTs). Set this explicitly in production —
# if left unset, a random one is generated at each server start, which
# invalidates all existing sessions on every restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
